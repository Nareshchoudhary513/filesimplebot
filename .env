# Copy this file to `.env` and fill in your own values.
# Never commit your real .env file to version control.

# ---- Telegram API credentials (https://my.telegram.org) ----
API_ID=123456
API_HASH=your_api_hash_here
BOT_TOKEN=123456:your_bot_token_from_botfather

# ---- MongoDB ----
# Local:  mongodb://localhost:27017
# Atlas:  mongodb+srv://username:password@cluster.mongodb.net
MONGO_URI=mongodb://localhost:27017
DATABASE_NAME=filestorebot

# ---- Force Subscribe ----
# Channel @username (without @) or numeric channel id (e.g. -1001234567890).
# The bot must be an admin of this channel. Leave empty to disable.
FORCE_SUB_CHANNEL=your_channel_username

# ---- Admins ----
# Comma-separated list of Telegram user ids allowed to generate links.
ADMINS=111111111,222222222

# ---- URL Shortener (optional) ----
# Works with any shortener that exposes GET <base_url>/api?api=<key>&url=<link>
# (e.g. GPLinks, ShrinkMe, ShareUS, and most AdLinkFly-based services).
# Leave both empty to disable shortening and use full links instead.
SHORTENER_API_KEY=your_shortener_api_key
SHORTENER_BASE_URL=shortener-domain.com
